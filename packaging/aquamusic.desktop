[Desktop Entry]
Name=AquaMusic
Comment=Local music player
Exec=aquamusic %U
Icon=aquamusic
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/x-vorbis+ogg;audio/mp4;audio/x-m4a;audio/wav;audio/x-wav;audio/aac;audio/x-aiff;
StartupWMClass=AquaMusic
